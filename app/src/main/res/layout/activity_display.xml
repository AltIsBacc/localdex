<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/displayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <com.localdex.DexSurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:alpha="0.5"
        android:background="@drawable/close_button_bg"
        android:contentDescription="Close display"
        android:src="@android:drawable/ic_menu_close_clear_cancel" />

    <TextView
        android:id="@+id/keyboardButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.5"
        android:background="@drawable/close_button_bg"
        android:contentDescription="Toggle keyboard"
        android:gravity="center"
        android:text="⌨"
        android:textColor="@color/white"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/touchButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="12dp"
        android:alpha="0.5"
        android:background="@drawable/close_button_bg"
        android:contentDescription="Toggle touch mode"
        android:gravity="center"
        android:text="🖱"
        android:textColor="@color/white"
        android:textSize="20sp" />
</FrameLayout>
